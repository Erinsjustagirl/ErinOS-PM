// Give yourself a unique ID! IDs usually follow the format of "author.program"
// The author part of your header should be your GitHub or similar.
// Generally, I would avoid using multiple lines in print commands, since it looks off in the console, but it's up to you!

header id "eringirl.example";
header author "Erinsjustagirl";
header version "1.0";
header icon "T"

print "start test";

var myVar = 2;
var myOtherVar = 3;
print myVar;
wait 2;
var myVar = myVar + myOtherVar;
print myVar;